{
  "ConnectionStrings": {
    "BmsDatabase": ""
  },
  "BmsSecurity": {
    "WindowsAuthentication": { "Enabled": true },
    "AllowDevelopmentActorHeaders": false,
    "ForwardedHeaders": { "Enabled": false },
    "Csrf": { "IssuesToken": true, "RequiresToken": true }
  },
  "BmsWeb": { "MaintenanceReadOnly": true },
  "Bms": {
    "BudgetAdjustments": {
      "WriteEnabled": true
    },
    "BusinessTimeZoneId": "Asia/Qyzylorda",
    "CurrencyRates": {
      "MaximumAgeDays": "0",
      "NationalBankImportEnabled": false
    },
    "Reporting": {
      "BusinessTimeZoneId": "Asia/Qyzylorda"
    },
    "DefaultBusinessRoles": {},
    "TaskMail": { "CaptureEnabled": false },
    "AccountingPayments": {
      "BudgetControlEnabled": false,
      "ReconciliationEnabled": false,
      "ReschedulingEnabled": false
    },
    "ActiveAccruals": {
      "YellowFromDays": 8,
      "OrangeFromDays": 15,
      "RedFromDays": 31
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "None",
      "Microsoft.EntityFrameworkCore.Database.Command": "None"
    },
    "EventLog": {
      "LogLevel": {
        "Default": "None",
        "Bms.Api.Diagnostics.ClientUiDiagnostics": "Warning"
      }
    }
  },
  "AllowedHosts": "localhost;127.0.0.1"
}
