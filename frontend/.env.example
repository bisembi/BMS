# Development only. Production builds always use the real /api endpoint.
# Mocks are deliberately opt-in; omit this variable (or set it to false) to
# exercise the real backend through the Vite /api proxy.
VITE_USE_MOCK_API=false
# Optional API origin or relative reverse-proxy prefix. Leave empty for /api.
VITE_API_BASE_URL=
# Development-only actor used with the backend's explicit development opt-in.
VITE_DEV_ACTOR_ID=dev-user
